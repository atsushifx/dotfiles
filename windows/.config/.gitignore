## default: all files are ignore
*

## track
!global-configs/
!global-configs/**


#   VSCode workspace
!.vscode/
!.vscode/cspell.json
!.vscode/cspell/
!.vscode/cspell/dicts/
!.vscode/cspell/dicts/*.dic

#   cspell 辞書
!vscode/
!vscode/cspell.config.json
!vscode/cSpell/
!vscode/cSpell/dicts/
!vscode/cSpell/dicts/*.dic

#   shell utils
!bd/
!bd/*.yaml
!glow/
!glow/*.yml
!worktrunk/
!worktrunk/*.toml

#   git / gh
!git/
!git/attributes
!git/config
!git/ignore
!gh/
!gh/config.yml

#   security
!gnupg/
!gnupg/*.conf
!gnupg/*.ps1


#   toolchain
!mise/
!mise/*.toml
!pnpm/
!pnpm/rc

#   editors
!emacs/
!emacs/*.el
!nvim/
!nvim/*.vim
!vimfiles/
!vimfiles/vimrc

#   languages
!ocaml/
!ocaml/*.ml
!racket/
!racket/config.rktd
!racket/racketrc.rktl

#   prose
!vale/
!vale/.vale.ini
!thunderbird/
!thunderbird/signature/
!thunderbird/signature/*.sign

#   AI agents
!claude/
!claude/*.md
!claude/settings.json
!claude/commands/
!claude/commands/**


##  Git
# allow all gitignore
!**/.gitignore

# ------------------------------------------------------------ ##
##  Re-exclude: secrets and generated files                      ##
##  Must stay last: these rules undo the broad allow rules above ##
## ------------------------------------------------------------ ##

#   OS specific files
.DS_Store
thumbs.db

#   logs, patches
**/*.log
**/*.diff
**/*.patch

#   history, cache
**/.history/
**/.cache/

#   backup/swap/temp
**/$~*
**/~*
**/*~
**/*.tmp
**/*.swp
**/*.lock

#   session files
**/*session.json
**/*session

#   .env files
**/.env*
!.env.example


#   API keys / credentials
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*apikey*
**/*api-key*
**/*api_key*

#   temporary directories
**/temp
**/tmp

#   node
**/node_modules/
**/.pnpm-store/
