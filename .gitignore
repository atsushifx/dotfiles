##  General
#   OS specific files
.DS_Store
thumbs.db

#   logs, patches
*.log
*.diff
*.patch

#   history, cache
.history/
.cache/
# **/*cache

# API keys / credentials
#   NOTE: 拡張子・区切りでアンカーする (旧 `*key` / `api*` は
#         `apitest/` や `mykey` のような無関係なパスまで巻き込んでいた)
*.key
*.pem
*.p12
*.pfx
*apikey*
*api-key*
*api_key*

#   backup/swap/temp
$~*
~*
*.tmp
*.swp
*.swo
*.lock

# session files
*.session
*session.json

# .env files
.env*
.env.*

## Development tools (installed locally)
.tools/

## Worktrees
# worktree base dir
.worktrees/

## AI generated files
**/.copilot

## Coding AI depended
**/.copilot/

# SDD (Spec-Driven Development) files
**/.cc-sdd/

# claude code setting
**/.claude/*

# agents can tracking
#   NOTE: `**/` を付けないとリポジトリ直下の .claude にしか効かない
!**/.claude/agents/
!**/.claude/agents/**
!**/.claude/rules/
!**/.claude/rules/**
!**/.claude/commands/
!**/.claude/commands/**

# MCP server dependency files
.cocoindex_code/
.serena/
.lsmcp/

## Temporary directories are never tracked
temp/
tmp/
**/temp/
**/tmp/

##  Editor
#   VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!.vscode/cspell*

## Node
node_modules/
